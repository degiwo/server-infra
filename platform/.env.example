# Template for .env (not versioned).

# Contact for Let's Encrypt
ACME_EMAIL=

# Apps live at <app>.<APPS_DOMAIN>
APPS_DOMAIN=

# LDAP base DN, derived from domain: example.com -> dc=example,dc=com
LDAP_BASE_DN=

# Secrets: openssl rand -hex 64 each
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=
LLDAP_JWT_SECRET=
LLDAP_KEY_SEED=

# Password of LLDAP admin user which Authelia uses to read users from LLDAP
LLDAP_ADMIN_PASSWORD=
